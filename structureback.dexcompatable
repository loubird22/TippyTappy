-- Audit Helpers
-- Note: The API needs to inject 'app.current_user_id' into the session before 
-- running updates, otherwise RLS will block the transaction.
CREATE OR REPLACE FUNCTION current_app_user_id() RETURNS INT AS $$ BEGIN     RETURN NULLIF(current_setting('app.current_user_id', true), '')::INT; END; $$ LANGUAGE plpgsql STABLE;
CREATE OR REPLACE FUNCTION current_app_user_role() RETURNS VARCHAR(20) AS $$ DECLARE     v_role VARCHAR(20); BEGIN     SELECT role INTO v_role FROM users WHERE user_id = current_app_user_id();     RETURN COALESCE(v_role, 'user'); END; $$ LANGUAGE plpgsql STABLE;
CREATE OR REPLACE FUNCTION fn_audit_update_timestamp_and_user() RETURNS TRIGGER AS $$ BEGIN     NEW.updated_at = CURRENT_TIMESTAMP;     IF NEW.updated_by_user_id IS NULL THEN         NEW.updated_by_user_id = current_app_user_id();     END IF;     RETURN NEW; END; $$ LANGUAGE plpgsql;

