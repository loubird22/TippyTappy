-- 6. PRESENTING UNITS (Households / Foster Families / Groups)
CREATE TABLE presenting_units (
    presentingunit_id VARCHAR(20) PRIMARY KEY DEFAULT ('PU-' || nextval('seq_presentingunit_id')::TEXT),
    unit_name VARCHAR(100) NOT NULL,
    created_by_user_id INT NOT NULL REFERENCES users(user_id),
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- 7. CLIENT -> UNIT JUNCTION (The Web)
-- CRITICAL: This is how we handle 1 child having multiple cases across different families over time.
-- If a child moves out, do NOT delete them here. Update their status or end_date (if added later).
CREATE TABLE client_presenting_units (
    client_id INT REFERENCES clients(client_id) ON DELETE RESTRICT,
    presentingunit_id VARCHAR(20) REFERENCES presenting_units(presentingunit_id) ON DELETE CASCADE,
    family_role VARCHAR(50) NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (client_id, presentingunit_id)
);
-- Reverse index: Makes "Show me everyone in Unit PU-100" lightning fast.
CREATE INDEX idx_cpu_unit_id ON client_presenting_units(presentingunit_id);

