-- 5. CLIENTS (Master Demographics)
-- A client is created once and never duplicated.

CREATE TABLE clients (
    client_id INT PRIMARY KEY
        DEFAULT nextval('seq_client_id'),

    first_name VARCHAR(50) NOT NULL,
    last_name VARCHAR(50) NOT NULL,

dob_year INT,
is_restricted_access BOOLEAN NOT NULL DEFAULT FALSE,
created_by_user_id INT NOT NULL
REFERENCES users(user_id),
created_at TIMESTAMPTZ NOT NULL
DEFAULT CURRENT_TIMESTAMP,
updated_by_user_id INT
REFERENCES users(user_id),
updated_at TIMESTAMPTZ NOT NULL
   DEFAULT CURRENT_TIMESTAMP
);

CREATE TRIGGER trg_clients_audit
BEFORE UPDATE ON clients
FOR EACH ROW
EXECUTE FUNCTION fn_audit_update_timestamp_and_user();

