-- 5. CLIENTS (Master Demographics)
-- NOTE: Never duplicate a client here if they change families. Update their junction table instead.
CREATE TABLE clients (
    client_id INT PRIMARY KEY DEFAULT nextval('seq_client_id'),
    first_name VARCHAR(50) NOT NULL,
    last_name VARCHAR(50) NOT NULL,
    dob_year INT,
    is_restricted_access BOOLEAN NOT NULL DEFAULT FALSE, -- The Security "Panic Button"
    created_by_user_id INT NOT NULL REFERENCES users(user_id),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_by_user_id INT REFERENCES users(user_id),
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE TRIGGER trg_clients_audit
BEFORE UPDATE ON clients FOR EACH ROW EXECUTE FUNCTION fn_audit_update_timestamp_and_user();

