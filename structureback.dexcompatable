-- 2. SEQUENCES
-- for generate readable, formatted IDs vs raw integers.
CREATE SEQUENCE seq_client_id START WITH 100000 MINVALUE 100000;
CREATE SEQUENCE seq_presentingunit_id START WITH 100000 MINVALUE 100000;
CREATE SEQUENCE seq_pe_id START WITH 1000 MINVALUE 1000;

-- 3. SESSION & AUDIT HELPERS
-- yo: The Python middle layer MUST set 'app.current_user_id' in the session 
-- before doing INSERTS/UPDATES, or the audit triggers and RLS will fail/block .
CREATE OR REPLACE FUNCTION current_app_user_id() RETURNS INT AS $$ BEGIN     RETURN NULLIF(current_setting('app.current_user_id', true), '')::INT; END; $$ LANGUAGE plpgsql STABLE;

CREATE OR REPLACE FUNCTION current_app_user_role() RETURNS VARCHAR(20) AS $$ DECLARE     v_role VARCHAR(20); BEGIN     SELECT role INTO v_role FROM users WHERE user_id = current_app_user_id();     RETURN COALESCE(v_role, 'user'); END; $$ LANGUAGE plpgsql STABLE;

-- This  catches any UPDATE and stamps the current time and user ID.
-- It prevents developers from having to manually write updated_at in every Python query.
CREATE OR REPLACE FUNCTION fn_audit_update_timestamp_and_user() RETURNS TRIGGER AS $$ BEGIN     NEW.updated_at = CURRENT_TIMESTAMP;     IF NEW.updated_by_user_id IS NULL THEN         NEW.updated_by_user_id = current_app_user_id();     END IF;     RETURN NEW; END; $$ LANGUAGE plpgsql;

-- 4. USERS (Staff / System Access)
CREATE TABLE users (
    user_id INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    username VARCHAR(50) UNIQUE NOT NULL,
    full_name VARCHAR(100) NOT NULL,
    role VARCHAR(20) NOT NULL DEFAULT 'user', -- Drives RLS permissions below
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

